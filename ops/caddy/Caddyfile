{
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		# Overwrite (never append) the client address: an appended value would let a caller prepend
		# a forged X-Forwarded-For and take over the login-throttle fingerprint when the app runs
		# with TRADE_FORWARD_HEADERS_STRATEGY=framework.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		}
}
