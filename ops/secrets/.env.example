# Copy to ops/secrets/.env (gitignored) or inject via Vault/SOPS/CI — never commit real values.
# Compose reads this file when present (see docker-compose.yml env_file).

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me-before-compose-up

