<?xml version="1.0" encoding="UTF-8"?>
<!--
  Neutral Maven settings for images built on CI runners or anywhere with direct Maven Central
  access. ops/maven/settings.xml remains the default because it mirrors Central to a regional
  endpoint, which is right for constrained networks and wrong (slow, occasionally unreachable)
  for GitHub-hosted runners. Select it with: MAVEN_SETTINGS=ops/maven/settings-central.xml
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors/>
</settings>
